Bootstrap: localimage
From: CADLLM2b.sif

# Adds the two packages Tier-2 IoU needs. Everything else is CADLLM2b unchanged.
#
# eval.py computes volumetric IoU by sampling points in the joint AABB and asking
# trimesh which of them fall inside each mesh. trimesh.contains() needs a spatial
# index, and without rtree it raises -- which eval.py catches and turns into NaN.
# The pipeline therefore ran to completion and reported every other metric while
# silently dropping IoU, one of the paper's headline numbers. Caught by running
# the evaluation end-to-end on an old checkpoint rather than waiting for the real
# ones.
#
# embreex is not required for correctness but the workload makes it worth having:
# 20 table cells x 1500 samples x 10,000 points is 300M point-in-mesh queries, and
# it supplies the fast ray backend for them.
#
# --no-deps is load-bearing. Without it pip pulls numpy 2.4.6 to satisfy embreex,
# which would shadow the 2.2.5 that torch 2.7 was built against. The image already
# has a numpy new enough for both.
#
#   singularity build --fakeroot CADLLM2c.sif container/cadllm2c.def
#
# Training keeps using CADLLM2b.sif -- these packages touch nothing in that path,
# and the running jobs must not have their image swapped underneath them.

%post
    set -eux
    pip install --no-cache-dir --no-deps "rtree" "embreex"

    python - <<'PY'
import numpy, trimesh, numpy as np, rtree, embreex, json

# Prove the metric actually computes rather than just that the import succeeds:
# two unit cubes offset by half a side have an analytic IoU of 1/3.
a = trimesh.creation.box((1, 1, 1))
b = trimesh.creation.box((1, 1, 1)); b.apply_translation([0.5, 0, 0])
rng = np.random.default_rng(0)
lo = np.minimum(a.bounds[0], b.bounds[0]); hi = np.maximum(a.bounds[1], b.bounds[1])
pts = rng.uniform(lo, hi, size=(20000, 3))
ia, ib = a.contains(pts), b.contains(pts)
iou = float((ia & ib).sum() / (ia | ib).sum())
assert abs(iou - 1/3) < 0.02, f"IoU sanity check failed: {iou}"

info = {"numpy": numpy.__version__, "trimesh": trimesh.__version__,
        "rtree": rtree.__version__, "iou_unit_test": round(iou, 4)}
open("/opt/cadllm2c_eval_check.json", "w").write(json.dumps(info, indent=2))
print(json.dumps(info, indent=2))
PY

%labels
    Name CADLLM2c
    Purpose CADLLM2b plus rtree/embreex so Tier-2 IoU is computable
